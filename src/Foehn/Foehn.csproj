<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Foehn</RootNamespace>
    <UserSecretsId>2f2f8f8b-2a6a-4a1c-9a8f-6a1b6ec2f7d1</UserSecretsId>
     <VersionPrefix>1.0.0</VersionPrefix>
     <Authors>Bryn Lewis</Authors>
     <Title>Foehn tool a lightweight AI coding assistant</Title>
     <Company>devMobile Software</Company>
     <Product>Foehn</Product>
     <Copyright>devmobile Software (c) 2026</Copyright>
     <PackageProjectUrl></PackageProjectUrl>
     <RepositoryUrl>https://github.com/KiwiBryn/Foehn</RepositoryUrl>
     <PackageTags>mistral, mistralAI, AI, Agentic</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".skills\csharp.md" />
    <None Include=".skills\dotnet.md" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Foehn.Tools.Abstractions\Foehn.Tools.Abstractions.csproj" />
    <ProjectReference Include="..\MistralAI.Client.Composite\MistralAI.Client.Composite.csproj" />
  </ItemGroup>

  <!-- FoehnBlunt is its own standalone project living under this folder; exclude it so
       its files don't get swept into Foehn's own compilation. -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Microsoft.Extensions.Options" />
    <Using Include="System.Reflection" />
    <Using Include="System.Runtime.Loader" />
    <Using Include="System.Text.Json" />
  </ItemGroup>
  <ItemGroup>
    <None Update="csharp.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="dotnet.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="filesystem.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Foehn.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
